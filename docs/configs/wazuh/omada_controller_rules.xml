<!--
  Omada Software Controller 6.3.x rules. Pairs with omada_controller_decoders.xml.
  Deploy to: /var/ossec/etc/rules/omada_controller_rules.xml on CT 100.
  IDs 100600-100609 are reserved for this file. 100500 (ER605 DHCP test rule) is untouched.
-->
<group name="omada,omada_controller,syslog,">

  <!-- Base: any controller event. Level 0 so unknown messages stay off the dashboard. -->
  <rule id="100600" level="0">
    <decoded_as>omada-controller</decoded_as>
    <description>Omada controller: event from site $(omada_site).</description>
  </rule>

  <rule id="100601" level="3">
    <if_sid>100600</if_sid>
    <match>] is roaming from [ap:</match>
    <description>Omada controller: client $(client_name) ($(client_mac)) roamed from $(from_ap_name) to $(to_ap_name) on SSID $(ssid).</description>
    <group>omada_roaming,</group>
  </rule>

  <!-- 100602 / 100603 reserved: client online / offline (wired and wireless).
       TODO: add once real samples and decoder blocks exist. -->

  <!-- Controller copy of a DHCP lease. Level 0 so it does not alert twice next to the
       ER605 lease rule (100500). Kept as a rule so later CDB lookups can use if_sid 100604. -->
  <rule id="100604" level="0">
    <if_sid>100600</if_sid>
    <match>DHCP Server allocated IP address</match>
    <description>Omada controller: DHCP allocated $(client_ip) to $(client_mac) (controller copy).</description>
    <group>omada_dhcp,</group>
  </rule>

  <rule id="100605" level="3">
    <if_sid>100600</if_sid>
    <field name="operation" type="pcre2">.</field>
    <description>Omada controller audit: $(operation)</description>
    <group>omada_audit,</group>
  </rule>

  <!-- Same client roaming 3+ times in 10 minutes. -->
  <rule id="100606" level="5" frequency="3" timeframe="600">
    <if_matched_sid>100601</if_matched_sid>
    <same_field>client_mac</same_field>
    <description>Omada controller: client $(client_name) ($(client_mac)) roamed 3+ times in 10 minutes.</description>
    <group>omada_roaming,</group>
  </rule>

</group>
